{
  "name": "@regenic/wecom-connector",
  "version": "0.1.0",
  "private": true,
  "description": "WeCom chat connector for Regenic. Long-connection robot ingest and replies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regenic-ai/wecom-connector.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wecom-connector": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "regenic": {
    "plugin": true,
    "catalogOrder": 36,
    "id": "@regenic/wecom-connector",
    "displayName": "WeCom",
    "engines": {
      "regenic": "1.0"
    },
    "contributes": {
      "drivers": [
        "wecomChatDriver"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "link-regenic": "node scripts/link-regenic.mjs --required",
    "prebuild": "node scripts/link-regenic.mjs --required",
    "pretest": "node scripts/link-regenic.mjs --required",
    "test": "tsc -p tsconfig.json && node --test test/*.test.cjs",
    "typecheck": "node scripts/link-regenic.mjs --required && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.6"
  },
  "peerDependencies": {
    "@regenic/connector-contract": ">=0.1.0",
    "@regenic/plugin-host": ">=0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "ws": "^8.18.3"
  }
}
